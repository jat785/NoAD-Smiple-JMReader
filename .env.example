# 复制这个文件为 .env 再改（.env 已在 .gitignore 里，不会被提交）
#
# 一切都可留空 —— 留空就用下面的默认值。

# ---- 服务监听 ----
# 默认只监听本机。想让局域网里的手机也能访问，改成 0.0.0.0
JMREADER_HOST=127.0.0.1
JMREADER_PORT=8756

# ---- 数据目录（默认是项目下的 data/）----
# JMREADER_DATA_DIR=D:/JMReaderData

# ---- 代理（留空 = 自动探测系统代理）----
# 也可以不改文件：App 的「设置」页面里能直接配，那里的优先级更高。
# JMREADER_PROXY=http://127.0.0.1:7890

# ---- 对站点的负担（默认已经很克制，一般不用动）----
# 全局限速：两次上游请求的最小间隔（秒）。0 表示不限速。
JMREADER_MIN_REQUEST_INTERVAL=0.2
# 随机池额外抓几个「随机分类 × 随机页」，设 0 就只用官方推荐位
JMREADER_HOME_POOL_SOURCES=5
# 以下各项缓存时长（秒）
JMREADER_RANDOM_POOL_TTL=21600
JMREADER_CATEGORIES_TTL=21600
JMREADER_ALBUM_TTL=1800

# ---- 下载：请保持克制 ----
# 同一时刻的下载任务数。禁漫站点运营不易，强烈建议保持 1。
JMREADER_DOWNLOAD_CONCURRENCY=1
# 每张图片之间的间隔（秒）
JMREADER_DOWNLOAD_INTERVAL=1.2

# ---- 首页 ----
# 默认页随机展示几部漫画
JMREADER_HOME_RANDOM_COUNT=10
